/* ---------- DEPLOYMENT & LIVE DATA SYNC ---------- */
const KEY_CSV_URL = "firststep.csvurl.v1";
const STATUS_BY_LABEL = Object.fromEntries(Object.entries(STATUS).map(([k,v])=>[v.label.toLowerCase(), k]));

function parseCsvRow(line){
  const out = []; let cur = "", inQ = false;
  for(let i=0;i<line.length;i++){
    const ch = line[i];
    if(inQ){
      if(ch==='"' && line[i+1]==='"'){ cur+='"'; i++; }
      else if(ch==='"'){ inQ=false; }
      else cur+=ch;
    } else {
      if(ch==='"') inQ=true;
      else if(ch===','){ out.push(cur); cur=""; }
      else cur+=ch;
    }
  }
  out.push(cur);
  return out;
}

function applyTrackerCsv(csvText){
  const clean = csvText.replace(/^\uFEFF/, "");
  const lines = clean.split(/\r?\n/).filter(l=>l.trim());
  if(lines.length < 2) throw new Error("CSV has no data rows");
  const headers = parseCsvRow(lines[0]).map(h=>h.trim().toLowerCase());
  const idx = (names) => headers.findIndex(h => names.some(n => h.includes(n)));
  const iName = idx(["participant", "name"]);
  const iWeek = idx(["week"]);
  const iStatus = idx(["status"]);
  const iEv = idx(["evidence"]);
  const iNote = idx(["note"]);
  const iScore = idx(["score (0-25)", "total", "score"]);
  const iBy = idx(["scored by", "reviewed by"]);
  if(iName < 0 || iWeek < 0 || iStatus < 0) throw new Error("CSV must include Participant, Week, and Status columns");

  let updatedCount = 0;
  for(let r=1; r<lines.length; r++){
    const cols = parseCsvRow(lines[r]);
    const rawName = (cols[iName]||"").trim().toLowerCase();
    const p = DATA.participants.find(x => x.name.toLowerCase()===rawName || x.short.toLowerCase()===rawName || x.id===rawName);
    const wMatch = String(cols[iWeek]||"").match(/(\d+)/);
    if(!p || !wMatch) continue;
    const w = Number(wMatch[1]);
    const stLabel = (cols[iStatus]||"").trim().toLowerCase();
    const sKey = STATUS[stLabel] ? stLabel : (STATUS_BY_LABEL[stLabel] || null);
    if(sKey){
      const base = (DATA.cells[p.id] && DATA.cells[p.id][w]) || {};
      overrides[p.id+"|"+w] = {
        s: sKey,
        ev: iEv >= 0 && cols[iEv] !== undefined ? cols[iEv].trim() : (base.ev || ""),
        note: iNote >= 0 && cols[iNote] !== undefined ? cols[iNote].trim() : (base.note || ""),
        updated: "Synced CSV"
      };
      updatedCount++;
    }
  }
  save(KEY_CELLS, overrides);
  renderAll();
  return updatedCount;
}

async function fetchRemoteCsv(url, silent){
  try{
    const res = await fetch(url, { cache: "no-store" });
    if(!res.ok) throw new Error("HTTP " + res.status);
    const text = await res.text();
    const n = applyTrackerCsv(text);
    if(!silent) toast(`Synced ${n} rows from live CSV`);
  }catch(err){
    if(!silent) toast("Live CSV sync failed: " + err.message);
  }
}

function openSyncModal(){
  modalCtx = { type:"sync" };
  const savedUrl = localStorage.getItem(KEY_CSV_URL) || "";
  $("#modalTitle").textContent = "Data sync & deployment state";
  $("#modalSub").textContent = "Connect a published Google Sheet CSV or import/export tracker files";
  $("#modalBody").innerHTML = `
    <div class="callout info">
      <div><b>Zero-backend live sync:</b> Publish your Google Sheet tracker as CSV (<i>File → Share → Publish to web → CSV</i>) and paste the link below, or share this dashboard with <code>?csv=YOUR_ENCODED_URL</code>.</div>
    </div>
    <div class="field">
      <label>Live Google Sheet CSV URL (auto-loads on open)</label>
      <input id="mCsvUrl" type="url" placeholder="https://docs.google.com/spreadsheets/d/e/.../pub?output=csv" value="${esc(savedUrl)}">
    </div>
    <div class="toolbar">
      <button class="btn primary sm" id="mSaveCsvUrl">Save &amp; sync URL</button>
      ${savedUrl ? `<button class="btn sm" id="mClearCsvUrl">Disconnect URL</button>` : ""}
    </div>
    <hr style="border:0;border-top:1px solid var(--line);margin:4px 0">
    <div class="field">
      <label>Import Master Tracker CSV from disk</label>
      <input id="mCsvFile" type="file" accept=".csv,text/csv">
      <div class="readonly-note">Accepts exported tracker CSVs or FIRST-STEP-Master-Tracker.csv matching Participant, Week, Status, Evidence, Note.</div>
    </div>
    <hr style="border:0;border-top:1px solid var(--line);margin:4px 0">
    <div class="toolbar" style="justify-content:space-between">
      <button class="btn sm" id="mExportBackup">Download JSON backup</button>
      <button class="btn sm" id="mResetLocal" style="color:var(--red);border-color:#f2b8b5">Reset browser edits</button>
    </div>
  `;
  $("#modalSave").style.display = "none";
  $("#modalFoot").textContent = "Static single-file deployment ready (Netlify, Vercel, GitHub Pages, Cloudflare Pages)";
  $("#overlay").classList.add("open");

  $("#mSaveCsvUrl").addEventListener("click", async ()=>{
    const u = $("#mCsvUrl").value.trim();
    if(!u){ toast("Paste a valid CSV URL first"); return; }
    localStorage.setItem(KEY_CSV_URL, u);
    await fetchRemoteCsv(u, false);
    closeModal();
  });
  if($("#mClearCsvUrl")){
    $("#mClearCsvUrl").addEventListener("click", ()=>{
      localStorage.removeItem(KEY_CSV_URL);
      toast("Disconnected live CSV URL");
      closeModal();
    });
  }
  $("#mCsvFile").addEventListener("change", e=>{
    const file = e.target.files && e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try{
        const n = applyTrackerCsv(String(reader.result||""));
        toast(`Imported ${n} rows from ${file.name}`);
        closeModal();
      }catch(err){
        toast("Import error: " + err.message);
      }
    };
    reader.readAsText(file);
  });
  $("#mExportBackup").addEventListener("click", ()=>{
    const payload = JSON.stringify({ overrides, scores, actionState, exportedAt: new Date().toISOString() }, null, 2);
    download("FIRST-STEP-backup-"+new Date().toISOString().slice(0,10)+".json", payload, "application/json");
    toast("JSON backup downloaded");
  });
  $("#mResetLocal").addEventListener("click", ()=>{
    localStorage.removeItem(KEY_CELLS);
    localStorage.removeItem(KEY_ACTIONS);
    localStorage.removeItem(KEY_SCORES);
    overrides = {};
    actionState = {};
    scores = Object.assign({}, DATA.seedScores || {});
    renderAll();
    toast("Browser edits cleared — restored baseline data");
    closeModal();
  });
}

$("#btnSync").addEventListener("click", openSyncModal);

// Auto-sync if ?csv= query param or saved CSV URL is present
(function initRemoteSync(){
  const params = new URLSearchParams(window.location.search);
  const qCsv = params.get("csv");
  if(qCsv){
    localStorage.setItem(KEY_CSV_URL, qCsv);
    fetchRemoteCsv(qCsv, false);
  } else {
    const saved = localStorage.getItem(KEY_CSV_URL);
    if(saved) fetchRemoteCsv(saved, true);
  }
})();

renderAll();
