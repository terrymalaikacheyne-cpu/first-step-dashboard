/* ---------- export / copy ---------- */
function exportCsv(){
  const head = ["Participant","Account","Agent ID","Week","Module","Session date","Status","Evidence","Note","Score (0-25)","Score band","Scored by","Owner","Due"];
  const rows = [head];
  DATA.participants.forEach(p=>DATA.weeks.forEach(w=>{
    const rec = cellRec(p.id,w.n);
    const sc = scoreRec(p.id,w.n);
    rows.push([p.name,p.account,p.agent,"W"+w.n,w.module,w.date,STATUS[rec.s].label,rec.ev||"",rec.note||"",
      sc&&sc.scored?sc.total:"", sc&&sc.scored?bandOf(sc.total).label:"", sc?sc.by||"":"", DATA.meta.owner,""]);
  }));
  const csv = rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\r\n");
  download("FIRST-STEP-tracker-"+new Date().toISOString().slice(0,10)+".csv", "\uFEFF"+csv, "text/csv;charset=utf-8");
  toast("Tracker CSV downloaded");
}
function download(name, content, type){
  const blob = new Blob([content], {type});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
}
function buildUpdate(){
  const all = deliveredCells();
  const documented = all.filter(x=>["complete","partial"].includes(x.rec.s)).length;
  const open = all.filter(x=>["missing","unverified","partial"].includes(x.rec.s)).length;
  const b = { unverified:0, partial:0, missing:0 };
  all.forEach(x=>{ if(x.rec.s in b) b[x.rec.s]++; });
  const sCount = scoredCount();
  const sAvg = cohortAvg();
  const ca = criterionAverages();
  const lowest = ca.length ? ca[0] : null;
  const below = all.filter(x=>{
    const r = scoreRec(x.p.id,x.w);
    if(!r || !r.scored) return false;
    const crit = criteriaFor(x.w);
    return r.total < 15 || crit.some(c => (r.v[c.id]||0) < 3);
  }).map(x=>x.p.short);
  return `**Subject:** F.I.R.S.T. STEP — Month 1 close-out (Week 3 of 7): delivery on track, evidence is the gap

Hi all,

**Bottom line:** Curriculum delivery remains on schedule — 3 of 7 weeks delivered, Month 1 closes this week, and Weeks 5–7 are fully built. Documented completion now stands at ${documented} of 18 participant-week items (${pct(documented,18)}%), with ${open} items still open (${b.unverified} not verifiable, ${b.partial} partial, ${b.missing} missing). Converting engagement into evidence is the only open workstream.

**Where we stand**
- Week 1 — complete for 4 of 6, partial for 1 (Krystel), 1 evidence gap (Jan's folder copy is blank).
- Weeks 2–3 — 1 of 6 complete each week (Kyle submitted and scored on 17 Nov); remaining 5 have no submissions in the shared folder (4 not verifiable, plus Jan's Week 3 missing).
- Week 4 (Intermediate Analytics) runs today; Week 5–7 content is built and ready.

**Assessment scoring**
- ${sCount} of 18 delivered logs scored${sAvg!==null?`; cohort average ${sAvg.toFixed(1)} / 25 (${bandOf(Math.round(sAvg)).label})`:""}.
${lowest?`- Lowest criterion so far: ${lowest.name} (${lowest.avg.toFixed(1)} / 5).`:""}
${below.length?`- Below the 15/25 gate: ${below.join(", ")}.`:"- No scored log is below the 15/25 gate."}
- Rubric: four core criteria plus one week-specific criterion, five points each.

**Next two weeks**
- Single master tracker plus a 30-second submission form; back-fill Weeks 2–4 by 21 Nov.
- Protected 45-minute window for Krystel, agreed with the Ode lead as a client commitment.
- Month 2: confirm department track, lock shadow buddies, open capstone scoping from the Week 5 lifecycle module.

Best,
${DATA.meta.owner}
${DATA.meta.role}`;
}
async function copyUpdate(){
  const text = buildUpdate();
  try{
    await navigator.clipboard.writeText(text);
    toast("Leadership update copied to clipboard");
  }catch(e){
    const ta = document.createElement("textarea");
    ta.value = text; document.body.appendChild(ta); ta.select();
    try{ document.execCommand("copy"); toast("Leadership update copied"); }catch(_){ toast("Copy failed — open Print / PDF instead"); }
    ta.remove();
  }
}

