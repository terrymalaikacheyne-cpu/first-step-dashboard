<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>F.I.R.S.T. STEP — Leadership Pilot Dashboard</title>
<style>
  :root{
    --bg:#f5f7fa; --panel:#ffffff; --ink:#101828; --muted:#5b6779; --line:#e4e8ef;
    --brand:#0f766e; --brand-dk:#115e59; --brand-soft:#e6f4f1;
    --amber:#b54708; --amber-soft:#fffaeb; --red:#b42318; --red-soft:#fef3f2;
    --green:#067647; --green-soft:#ecfdf3; --blue:#1d4ed8; --blue-soft:#eff4ff;
    --grey:#475467; --grey-soft:#f2f4f7; --purple:#6941c6; --purple-soft:#f4f3ff;
    --radius:14px; --shadow:0 1px 2px rgba(16,24,40,.06),0 1px 3px rgba(16,24,40,.1);
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 "Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif}
  h1,h2,h3,h4{margin:0;line-height:1.25;letter-spacing:-.01em}
  h1{font-size:20px;font-weight:650}
  h2{font-size:17px;font-weight:650}
  h3{font-size:14px;font-weight:650}
  p{margin:0}
  a{color:var(--brand);text-decoration:none}
  button{font:inherit;color:inherit;cursor:pointer}
  .wrap{max-width:1320px;margin:0 auto;padding:0 20px 64px}

  /* ---------- header ---------- */
  header.top{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:saturate(180%) blur(10px);border-bottom:1px solid var(--line)}
  .top-in{max-width:1320px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .brandmark{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#0f766e,#134e4a);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px;letter-spacing:.5px;flex:none}
  .titles{flex:1;min-width:220px}
  .titles .sub{color:var(--muted);font-size:12px;margin-top:2px}
  .top-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11.5px;font-weight:600;border:1px solid transparent;white-space:nowrap}
  .pill.live{background:var(--brand-soft);color:var(--brand-dk);border-color:#bfe5df}
  .pill.date{background:var(--grey-soft);color:var(--grey);border-color:#e4e7ec}
  .btn{display:inline-flex;align-items:center;gap:6px;border:1px solid #d0d5dd;background:#fff;padding:7px 11px;border-radius:9px;font-size:12.5px;font-weight:600;color:#344054;transition:.15s}
  .btn:hover{background:#f9fafb;border-color:#98a2b3}
  .btn.primary{background:var(--brand);border-color:var(--brand);color:#fff}
  .btn.primary:hover{background:var(--brand-dk)}
  .btn.on{background:var(--amber-soft);border-color:#f5c26b;color:var(--amber)}
  .btn.sm{padding:5px 9px;font-size:12px}
  .btn svg{width:14px;height:14px}

  nav.tabs{max-width:1320px;margin:0 auto;padding:0 20px;display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}
  nav.tabs::-webkit-scrollbar{display:none}
  .tab{position:relative;border:0;background:none;padding:11px 13px;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;border-bottom:2px solid transparent}
  .tab:hover{color:var(--ink)}
  .tab[aria-selected="true"]{color:var(--brand-dk);border-bottom-color:var(--brand)}
  .tab .count{display:inline-block;min-width:18px;padding:0 5px;margin-left:6px;border-radius:999px;background:var(--grey-soft);color:var(--grey);font-size:10.5px;line-height:17px;text-align:center;vertical-align:1px}
  .tab[aria-selected="true"] .count{background:var(--brand-soft);color:var(--brand-dk)}

  /* ---------- layout ---------- */
  main{padding-top:20px}
  .view{display:none}
  .view.active{display:block;animation:fade .18s ease}
  @keyframes fade{from{opacity:0;transform:translateY(2px)}to{opacity:1;transform:none}}
  .grid{display:grid;gap:14px}
  .g3{grid-template-columns:repeat(6,1fr)}
  .g2{grid-template-columns:2fr 1fr}
  .g2b{grid-template-columns:1fr 1fr}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
  .card-h{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line);flex-wrap:wrap}
  .card-h .hint{font-size:11.5px;color:var(--muted);font-weight:500}
  .card-b{padding:16px}
  .card-b.tight{padding:10px 12px}
  .section-title{display:flex;align-items:center;justify-content:space-between;margin:26px 0 10px;gap:12px;flex-wrap:wrap}
  .section-title p{color:var(--muted);font-size:12.5px}
  .muted{color:var(--muted)}
  .small{font-size:12px}
  .tiny{font-size:11px}
  .strong{font-weight:650}

  /* ---------- KPI ---------- */
  .kpi{grid-column:span 2;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px 16px;position:relative;overflow:hidden}
  .kpi .k-label{font-size:11.5px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;display:flex;align-items:center;gap:7px}
  .kpi .k-val{font-size:28px;font-weight:680;letter-spacing:-.02em;margin:6px 0 2px;font-variant-numeric:tabular-nums}
  .kpi .k-val span{font-size:15px;font-weight:600;color:var(--muted);letter-spacing:0}
  .kpi .k-sub{font-size:12px;color:var(--muted)}
  .kpi .bar{height:5px;border-radius:99px;background:#eef1f5;margin-top:10px;overflow:hidden}
  .kpi .bar i{display:block;height:100%;border-radius:99px;background:var(--brand)}
  .kpi.risk .bar i{background:var(--red)}
  .kpi.warn .bar i{background:#dc6803}
  .kpi .k-icon{position:absolute;right:12px;top:12px;width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font-size:13px}
  .k-green{background:var(--green-soft);color:var(--green)}
  .k-blue{background:var(--blue-soft);color:var(--blue)}
  .k-amber{background:var(--amber-soft);color:var(--amber)}
  .k-red{background:var(--red-soft);color:var(--red)}
  .k-purple{background:var(--purple-soft);color:var(--purple)}
  .k-teal{background:var(--brand-soft);color:var(--brand-dk)}

  /* ---------- matrix ---------- */
  .matrix-scroll{overflow-x:auto}
  table.matrix{border-collapse:separate;border-spacing:0;width:100%;min-width:720px}
  table.matrix th,table.matrix td{padding:0}
  table.matrix thead th{background:#fff;font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em;padding:9px 6px;border-bottom:1px solid var(--line);text-align:center;vertical-align:bottom}
  table.matrix thead th:first-child{text-align:left;padding-left:14px;position:sticky;left:0;z-index:3}
  table.matrix thead th .wk{display:block;color:var(--ink);font-size:12px;text-transform:none;letter-spacing:0}
  table.matrix thead th .dt{display:block;font-weight:500;font-size:10.5px;text-transform:none;letter-spacing:0}
  table.matrix tbody th{text-align:left;padding:9px 10px 9px 14px;border-bottom:1px solid #f0f2f6;font-weight:600;font-size:12.5px;position:sticky;left:0;background:#fff;z-index:2;min-width:186px}
  table.matrix tbody th .who{display:flex;align-items:center;gap:8px}
  table.matrix tbody th .acct{display:block;font-weight:500;font-size:10.5px;color:var(--muted);margin-left:30px}
  .avatar{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-weight:700;color:#fff;flex:none}
  table.matrix tbody td{border-bottom:1px solid #f0f2f6;padding:5px;text-align:center}
  table.matrix tbody tr:last-child td,table.matrix tbody tr:last-child th{border-bottom:0}
  .cell{width:100%;min-width:52px;height:38px;border-radius:9px;border:1px solid transparent;display:grid;place-items:center;font-size:11px;font-weight:650;gap:0;transition:.12s;padding:2px}
  .cell:hover{transform:translateY(-1px);box-shadow:0 3px 8px rgba(16,24,40,.14)}
  .cell .ci{font-size:12px;line-height:1}
  .cell .cl{font-size:9.5px;line-height:1.1;font-weight:600;opacity:.9}
  .s-complete{background:var(--green-soft);color:var(--green);border-color:#a9e6c3}
  .s-partial{background:var(--amber-soft);color:var(--amber);border-color:#f5c26b}
  .s-unverified{background:var(--grey-soft);color:var(--grey);border-color:#d0d5dd;border-style:dashed}
  .s-missing{background:var(--red-soft);color:var(--red);border-color:#f2b8b5}
  .s-scheduled{background:var(--blue-soft);color:var(--blue);border-color:#b2c6fe}
  .s-planned{background:#fbfcfd;color:#98a2b3;border-color:#eaecf0}
  .s-exited{background:#f9fafb;color:#98a2b3;border-color:#eaecf0;text-decoration:line-through}
  .legend{display:flex;gap:12px;flex-wrap:wrap;align-items:center;font-size:11.5px;color:var(--muted)}
  .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px;border:1px solid transparent}

  /* ---------- bars ---------- */
  .stack{display:flex;height:26px;border-radius:7px;overflow:hidden;background:#f2f4f7;margin:8px 0 4px}
  .stack span{display:block;height:100%;font-size:10px;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:center;min-width:0}
  .stack .c{background:#12b76a}.stack .p{background:#f79009}.stack .u{background:#98a2b3}.stack .m{background:#f04438}
  .wl{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:6px}
  .disc-row{display:grid;grid-template-columns:74px 1fr 28px;gap:8px;align-items:center;font-size:11.5px;margin:7px 0}
  .disc-track{height:8px;background:#eef1f5;border-radius:99px;overflow:hidden;display:flex;gap:2px}
  .disc-track i{display:block;height:100%;border-radius:99px}

  /* ---------- timeline ---------- */
  .tl{display:flex;gap:6px;margin-top:4px}
  .tl-step{flex:1;text-align:center;position:relative}
  .tl-dot{width:100%;height:8px;border-radius:99px;background:#e9edf2;margin-bottom:6px}
  .tl-step.done .tl-dot{background:var(--brand)}
  .tl-step.now .tl-dot{background:linear-gradient(90deg,var(--brand) 0 50%,#e9edf2 50% 100%)}
  .tl-step.built .tl-dot{background:#a6d9d2}
  .tl-step .t{font-size:10px;color:var(--muted);font-weight:600}
  .tl-step .n{font-size:9.5px;color:#98a2b3}
  .tl-step.now .t{color:var(--brand-dk)}

  /* ---------- lists ---------- */
  .list{display:flex;flex-direction:column}
  .li{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid #f0f2f6;align-items:flex-start}
  .li:last-child{border-bottom:0}
  .li .dot{width:7px;height:7px;border-radius:50%;margin-top:6px;flex:none}
  .li .body{flex:1;min-width:0}
  .li h4{font-size:12.5px;font-weight:650}
  .li p{font-size:11.5px;color:var(--muted);margin-top:1px}
  .li .meta{font-size:10.5px;color:#98a2b3;margin-top:3px;display:flex;gap:8px;flex-wrap:wrap}

  .sev{display:inline-flex;align-items:center;gap:4px;padding:2px 7px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;white-space:nowrap}
  .sev.high{background:var(--red-soft);color:var(--red);border:1px solid #f2b8b5}
  .sev.med{background:var(--amber-soft);color:var(--amber);border:1px solid #f5c26b}
  .sev.low{background:var(--grey-soft);color:var(--grey);border:1px solid #e4e7ec}
  .sev.ok{background:var(--green-soft);color:var(--green);border:1px solid #a9e6c3}

  /* ---------- checklist ---------- */
  .check{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px dashed #eef1f5}
  .check:last-child{border-bottom:0}
  .check input{width:16px;height:16px;margin-top:2px;accent-color:var(--brand);flex:none}
  .check label{flex:1;cursor:pointer}
  .check label .t{font-size:12.5px;font-weight:600;display:block}
  .check label .d{font-size:11px;color:var(--muted)}
  .check label .o{font-size:10.5px;color:#98a2b3;margin-top:2px;display:block}
  .check input:checked + label .t{text-decoration:line-through;color:#98a2b3}

  /* ---------- participant cards ---------- */
  .p-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
  .p-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;text-align:left;transition:.15s;display:flex;flex-direction:column;gap:10px}
  .p-card:hover{border-color:#b8c1cd;box-shadow:0 4px 12px rgba(16,24,40,.1);transform:translateY(-1px)}
  .p-top{display:flex;gap:10px;align-items:center}
  .p-top .avatar{width:34px;height:34px;font-size:12px}
  .p-name{font-size:13.5px;font-weight:650}
  .p-sub{font-size:11px;color:var(--muted)}
  .p-stats{display:flex;gap:6px;flex-wrap:wrap}
  .chip{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:999px;font-size:10.5px;font-weight:600;background:var(--grey-soft);color:var(--grey);border:1px solid #eaecf0;white-space:nowrap}
  .chip.teal{background:var(--brand-soft);color:var(--brand-dk);border-color:#bfe5df}
  .chip.amber{background:var(--amber-soft);color:var(--amber);border-color:#f5c26b}
  .chip.red{background:var(--red-soft);color:var(--red);border-color:#f2b8b5}
  .chip.purple{background:var(--purple-soft);color:var(--purple);border-color:#d9d6fe}
  .p-cap{font-size:11.5px;color:#344054;background:#fbfcfd;border:1px solid #eef1f5;border-radius:8px;padding:7px 9px}
  .p-cap b{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;color:#98a2b3;margin-bottom:2px}
  .mini{display:flex;gap:4px}
  .mini span{flex:1;height:6px;border-radius:99px;background:#eef1f5}
  .mini span.ok{background:#12b76a}.mini span.part{background:#f79009}.mini span.unv{background:#d0d5dd}.mini span.miss{background:#f04438}.mini span.sched{background:#b2c6fe}

  /* ---------- pipeline ---------- */
  .pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .pcol{background:#fbfcfd;border:1px dashed #e4e7ec;border-radius:12px;padding:10px;min-height:150px}
  .pcol h4{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-bottom:8px;display:flex;justify-content:space-between}
  .pitem{background:#fff;border:1px solid var(--line);border-radius:9px;padding:8px;font-size:11.5px;margin-bottom:7px;box-shadow:0 1px 1px rgba(16,24,40,.04)}
  .pitem b{display:block;font-size:11.5px;margin-bottom:2px}
  .pitem .m{font-size:10.5px;color:var(--muted)}
  .pempty{font-size:11px;color:#98a2b3;text-align:center;padding:14px 4px}

  /* ---------- table ---------- */
  table.plain{width:100%;border-collapse:collapse;font-size:12px}
  table.plain th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);padding:8px 10px;border-bottom:1px solid var(--line);font-weight:650;white-space:nowrap}
  table.plain td{padding:10px;border-bottom:1px solid #f0f2f6;vertical-align:top}
  table.plain tr:last-child td{border-bottom:0}
  table.plain tr:hover td{background:#fcfcfd}

  /* ---------- scoring ---------- */
  table.sgrid{border-collapse:separate;border-spacing:0;width:100%;min-width:640px}
  table.sgrid th{font-size:10.5px;color:var(--muted);font-weight:650;text-transform:uppercase;letter-spacing:.03em;padding:8px 5px;border-bottom:1px solid var(--line);text-align:center;white-space:nowrap}
  table.sgrid thead th:first-child{text-align:left;padding-left:14px}
  table.sgrid tbody th{text-align:left;padding:7px 10px 7px 14px;border-bottom:1px solid #f0f2f6;font-size:12.5px;font-weight:600;white-space:nowrap;text-transform:none;letter-spacing:0}
  table.sgrid tbody th .acct{display:block;font-weight:500;font-size:10.5px;color:var(--muted);letter-spacing:0}
  table.sgrid tbody td{border-bottom:1px solid #f0f2f6;padding:5px;text-align:center}
  table.sgrid tbody tr:last-child td,table.sgrid tbody tr:last-child th{border-bottom:0}
  table.sgrid tfoot td,table.sgrid tfoot th{border-top:1px solid var(--line);padding:8px 5px;font-size:11.5px;font-weight:650;text-align:center;color:var(--muted);background:#fbfcfd;text-transform:none;letter-spacing:0}
  table.sgrid tfoot th{text-align:left;padding-left:14px}
  .scell{width:100%;min-width:48px;height:40px;border-radius:9px;border:1px solid transparent;display:flex;align-items:center;justify-content:center;gap:1px;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;transition:.12s;line-height:1}
  .scell:hover{transform:translateY(-1px);box-shadow:0 3px 8px rgba(16,24,40,.14)}
  .scell .tiny{font-weight:600;font-size:9.5px;opacity:.85;display:inline;margin-left:2px}
  .scell.none{background:#fbfcfd;border:1px dashed #e4e7ec;color:#98a2b3;font-weight:600;font-size:11px}
  .scell.future{background:#fbfcfd;border-color:#f2f4f7;color:#d0d5dd;font-weight:500;font-size:11px;cursor:default}
  .scell.future:hover{transform:none;box-shadow:none}
  .b-ex{background:var(--green-soft);color:var(--green);border-color:#a9e6c3}
  .b-pr{background:var(--brand-soft);color:var(--brand-dk);border-color:#bfe5df}
  .b-dev{background:var(--amber-soft);color:var(--amber);border-color:#f5c26b}
  .b-re{background:var(--red-soft);color:var(--red);border-color:#f2b8b5}
  .avgcell{font-weight:700;font-size:12.5px;color:var(--ink)}

  .score-row{border-bottom:1px solid #f0f2f6;padding:10px 0}
  .score-row:last-child{border-bottom:0}
  .sr-top{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
  .sr-name{font-weight:650;font-size:12.5px}
  .sr-weight{font-size:10px;color:#98a2b3;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
  .sr-scale{display:flex;gap:4px;margin-top:7px}
  .sb{width:36px;height:30px;border-radius:7px;border:1px solid #d0d5dd;background:#fff;font-weight:650;font-size:12px;color:#475467}
  .sb:hover{background:#f9fafb;border-color:#98a2b3}
  .sb.on{background:var(--brand);border-color:var(--brand);color:#fff}
  .sr-desc{font-size:11px;color:var(--muted);margin-top:6px;min-height:32px;line-height:1.4}
  .sr-desc b{color:#344054}
  .score-total{display:flex;align-items:center;gap:8px}
  .score-total .n{font-size:22px;font-weight:700;font-variant-numeric:tabular-nums}
  .score-total .n small{font-size:12px;font-weight:600;color:var(--muted)}

  .rub-row{border:1px solid var(--line);border-radius:10px;padding:11px 12px;margin-bottom:8px}
  .rub-row:last-child{margin-bottom:0}
  .rub-name{font-weight:650;font-size:12.5px;display:flex;align-items:center;gap:7px;flex-wrap:wrap}
  .rub-anchors{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:8px}
  .anchor{font-size:11px;color:var(--muted);line-height:1.45;background:#fbfcfd;border:1px solid #eef1f5;border-radius:8px;padding:7px 8px}
  .anchor b{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;color:#98a2b3;margin-bottom:2px}
  @media (max-width:700px){.rub-anchors{grid-template-columns:1fr}}

  /* ---------- misc ---------- */
  .callout{display:flex;gap:10px;padding:11px 12px;border-radius:10px;font-size:12px;line-height:1.45;border:1px solid}
  .callout.info{background:var(--blue-soft);border-color:#d1e0ff;color:#1e3a8a}
  .callout.warn{background:var(--amber-soft);border-color:#f5c26b;color:#7a2e0e}
  .callout.bad{background:var(--red-soft);border-color:#f2b8b5;color:#7a1d16}
  .callout.good{background:var(--green-soft);border-color:#a9e6c3;color:#054f31}
  .callout b{font-weight:700}
  .toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .search{display:flex;align-items:center;gap:6px;border:1px solid #d0d5dd;border-radius:9px;padding:0 10px;background:#fff;height:34px}
  .search input{border:0;outline:0;font:inherit;font-size:12.5px;width:170px;background:none}
  .seg{display:inline-flex;border:1px solid #d0d5dd;border-radius:9px;overflow:hidden;background:#fff}
  .seg button{border:0;background:none;padding:7px 11px;font-size:12px;font-weight:600;color:var(--muted)}
  .seg button.on{background:var(--brand);color:#fff}
  select.sel{border:1px solid #d0d5dd;border-radius:8px;padding:6px 8px;font:inherit;font-size:12.5px;background:#fff}
