function criterionAverages(){
  const acc = {};
  DATA.participants.forEach(p=>DELIVERED.forEach(w=>{
    const r = scoreRec(p.id,w);
    if(!r || !r.scored) return;
    criteriaFor(w).forEach(c=>{
      if(!acc[c.name]) acc[c.name] = [];
      acc[c.name].push(r.v[c.id]);
    });
  }));
  return Object.keys(acc).map(name=>{
    const v = acc[name];
    return { name, avg: v.reduce((a,b)=>a+b,0)/v.length, n:v.length };
  }).sort((a,b)=>a.avg-b.avg);
}

function descFor(c, v){
  if(v===1) return c.one;
  if(v===2) return c.one + " Some attempt, but largely unmet.";
  if(v===3) return c.three;
  if(v===4) return c.three + " Consistently met, with one clear gap.";
  if(v===5) return c.five;
  return "Not scored yet — select 1 to 5.";
}

function openScore(pid, w){
  const p = DATA.participants.find(x=>x.id===pid);
  const week = DATA.weeks.find(x=>x.n===w);
  const existing = scores[pid+"|"+w];
  scoreDraft = { pid, w, v: Object.assign({}, existing ? existing.v : {}) };
  modalCtx = { type:"score", pid, w };
  $("#modalTitle").textContent = `Score — ${p.short} · Week ${w}`;
  $("#modalSub").textContent = `${week.module} · ${week.date} · five criteria, five points each`;
  const crit = criteriaFor(w);
  $("#modalBody").innerHTML = `
    <div class="score-total" id="scoreTotal"></div>
    ${crit.map(c=>`
      <div class="score-row">
        <div class="sr-top"><div class="sr-name">${esc(c.name)}</div><div class="sr-weight">${c.focus?"Week focus":"Core"}</div></div>
        <div class="sr-scale">${[1,2,3,4,5].map(n=>`<button class="sb ${scoreDraft.v[c.id]===n?"on":""}" data-c="${c.id}" data-v="${n}" aria-label="${esc(c.name)}, score ${n} of 5">${n}</button>`).join("")}</div>
        <div class="sr-desc" id="sd-${c.id}"></div>
      </div>`).join("")}
    <div class="field"><label>Evidence / feedback to the participant</label><textarea id="mScoreNote" placeholder="One sentence per score. If below the gate, add the single rewrite instruction.">${esc(existing ? existing.note||"" : "")}</textarea></div>
    <div class="field"><label>Scored by</label><input id="mScoreBy" value="${esc(existing && existing.by ? existing.by : "Terry")}"></div>
    <div class="readonly-note">Gate: 15/25 or above with no criterion below 3. Saved in this browser — export the scores to keep the record.</div>`;
  $$("#modalBody .sb").forEach(b=>b.addEventListener("click", ()=>{
    scoreDraft.v[b.dataset.c] = Number(b.dataset.v);
    $$("#modalBody .score-row").forEach(row=>{
      const cid = row.querySelector(".sr-scale").firstElementChild.dataset.c;
      $$(".sb", row).forEach(x=>x.classList.toggle("on", scoreDraft.v[cid]===Number(x.dataset.v)));
    });
    updateScoreTotal();
  }));
  $("#modalSave").style.display = "inline-flex";
  $("#modalSave").textContent = "Save score";
  $("#modalFoot").textContent = "Four core criteria + one week focus · 5 points each · gate 15/25";
  $("#overlay").classList.add("open");
  updateScoreTotal();
}

function updateScoreTotal(){
  if(!scoreDraft) return;
  const crit = criteriaFor(scoreDraft.w);
  const total = crit.reduce((a,c)=>a+(scoreDraft.v[c.id]||0),0);
  const n = crit.filter(c=>scoreDraft.v[c.id]).length;
  const b = bandOf(total);
  $("#scoreTotal").innerHTML = `
    <div class="n">${total}<small> / 25</small></div>
    ${n===0 ? `<span class="chip">Not scored</span>` : `<span class="scell ${b.cls}" style="display:inline-flex;width:auto;height:auto;padding:4px 10px;font-size:11px">${b.label}</span>`}
    <span class="tiny muted">${n} of 5 criteria scored</span>`;
  crit.forEach(c=>{
    const el = $("#sd-"+c.id);
    if(!el) return;
    const v = scoreDraft.v[c.id];
    el.innerHTML = v ? `<b>${DATA.rubric.scale[v-1].label}:</b> ${esc(descFor(c,v))}` : `<span style="color:#98a2b3">${esc(descFor(c,0))}</span>`;
  });
}

function exportScores(){
  const head = ["Participant","Account","Week","Module","C1 Completion & accuracy","C2 Specificity","C3 Application","C4 Reflection depth","C5 Week focus","Focus criterion","Total (0-25)","Band","Scored by","Evidence / feedback","Updated"];
  const rows = [head];
  DATA.participants.forEach(p=>DATA.weeks.forEach(w=>{
    const r = scoreRec(p.id,w.n);
    const crit = criteriaFor(w.n);
    rows.push([
      p.name, p.account, "W"+w.n, w.module,
      r&&r.v[crit[0].id]||"", r&&r.v[crit[1].id]||"", r&&r.v[crit[2].id]||"", r&&r.v[crit[3].id]||"", r&&r.v[crit[4].id]||"",
      crit[4].name, r&&r.scored?r.total:"", r&&r.scored?bandOf(r.total).label:"",
      r?r.by||"":"", r?r.note||"":"", r?r.updated||"":""
    ]);
  }));
  const csv = rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\r\n");
  download("FIRST-STEP-scores-"+new Date().toISOString().slice(0,10)+".csv", "\uFEFF"+csv, "text/csv;charset=utf-8");
  toast("Scores CSV downloaded");
}

