const STATUS = {
  complete:   { label:"Complete",       icon:"✓", cls:"s-complete" },
  partial:    { label:"Partial",        icon:"◐", cls:"s-partial" },
  unverified: { label:"Not verifiable", icon:"?", cls:"s-unverified" },
  missing:    { label:"Missing",        icon:"!", cls:"s-missing" },
  scheduled:  { label:"Scheduled",      icon:"▸", cls:"s-scheduled" },
  planned:    { label:"Month 2",        icon:"·", cls:"s-planned" },
  exited:     { label:"Exited",         icon:"—", cls:"s-exited" }
};
const DELIVERED = [1,2,3];

const KEY_CELLS = "firststep.cells.v1";
const KEY_ACTIONS = "firststep.actions.v1";
const KEY_SCORES = "firststep.scores.v1";
let overrides = load(KEY_CELLS, {});
let actionState = load(KEY_ACTIONS, {});
let scores = Object.assign({}, DATA.seedScores || {}, load(KEY_SCORES, {}));
let editMode = false;
let acctFilter = "all";
let peopleQuery = "";
let rubricWeek = 1;
let scoreDraft = null;

function load(k, fb){ try{ return JSON.parse(localStorage.getItem(k)) || fb; }catch(e){ return fb; } }
function save(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
function $(s, r){ return (r||document).querySelector(s); }
function $$(s, r){ return Array.from((r||document).querySelectorAll(s)); }
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function toast(msg){ const t=$("#toast"); t.textContent=msg; t.classList.add("show"); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),2200); }

function cellRec(pid, w){
  const base = (DATA.cells[pid] && DATA.cells[pid][w]) || { s:"planned", ev:"", note:"" };
  const ov = overrides[pid+"|"+w];
  return ov ? Object.assign({}, base, ov) : base;
}
function criteriaFor(w){
  const wk = DATA.rubric.weeks[w];
  return DATA.rubric.common.concat([{ id:"w"+w, name:wk.name, one:wk.one, three:wk.three, five:wk.five, focus:true }]);
}
function scoreRec(pid, w){
  const s = scores[pid+"|"+w];
  if(!s || !s.v) return null;
  const crit = criteriaFor(w);
  const vals = crit.map(c=>s.v[c.id]).filter(v=>typeof v==="number");
  return Object.assign({}, s, {
    n: vals.length,
    total: vals.reduce((a,b)=>a+b,0),
    scored: vals.length === crit.length
  });
}
function bandOf(total){ return DATA.rubric.bands.find(b=>total>=b.min) || DATA.rubric.bands[DATA.rubric.bands.length-1]; }
function personAvg(pid){
  const recs = DATA.weeks.map(w=>scoreRec(pid,w.n)).filter(r=>r && r.scored);
  if(!recs.length) return null;
  return recs.reduce((a,r)=>a+r.total,0)/recs.length;
}
function scoredCount(){ return deliveredCells().filter(x=>{ const r=scoreRec(x.p.id,x.w); return r && r.scored; }).length; }
function cohortAvg(){
  const t = deliveredCells().map(x=>scoreRec(x.p.id,x.w)).filter(r=>r && r.scored).map(r=>r.total);
  return t.length ? t.reduce((a,b)=>a+b,0)/t.length : null;
}
function people(){ return DATA.participants.filter(p => acctFilter==="all" || p.account===acctFilter); }
function deliveredCells(){
  const out = [];
  DATA.participants.forEach(p => DELIVERED.forEach(w => out.push({ p, w, rec:cellRec(p.id,w) })));
  return out;
}
function countsForWeek(w){
  const c = { complete:0, partial:0, unverified:0, missing:0 };
  DATA.participants.forEach(p => { const s=cellRec(p.id,w).s; if(s in c) c[s]++; });
  return c;
}
function pct(n,d){ return d ? Math.round(n/d*100) : 0; }

/* ---------- KPIs ---------- */
function renderKpis(){
  const all = deliveredCells();
  const documented = all.filter(x => ["complete","partial"].includes(x.rec.s)).length;
  const verified = all.filter(x => x.rec.s==="complete").length;
  const open = all.filter(x => ["partial","unverified","missing"].includes(x.rec.s)).length;
  const byStatus = { partial:0, unverified:0, missing:0 };
  all.forEach(x => { if(x.rec.s in byStatus) byStatus[x.rec.s]++; });
  const sCount = scoredCount();
  const sAvg = cohortAvg();
  const peopleScored = DATA.participants.filter(p => DELIVERED.some(w => { const r=scoreRec(p.id,w); return r && r.scored; })).length;

  const kpis = [
    { label:"Curriculum delivered", val:"3", suf:"of 7 weeks", sub:"Month 1 closes this week · Month 2 fully built", bar:pct(3,7), icon:"▦", ink:"k-blue" },
    { label:"Documented completion", val:documented, suf:"of 18 items", sub:"Week 1–3 · complete or partial, with an artefact", bar:pct(documented,18), icon:"✓", ink:"k-amber" },
    { label:"Verified complete", val:verified, suf:"of 18 items", sub:"Rests on a real file, not a claim", bar:pct(verified,18), icon:"◉", ink:"k-green" },
    { label:"Open evidence items", val:open, suf:"to close", sub:`${byStatus.unverified} not verifiable · ${byStatus.partial} partial · ${byStatus.missing} missing`, bar:pct(open,18), icon:"!", ink:"k-red", cls:"risk" },
    { label:"Logs scored", val:sCount, suf:"of 18", sub:`${peopleScored} of 6 participants · 5 criteria each`, bar:pct(sCount,18), icon:"◧", ink:"k-purple" },
    { label:"Average log score", val:(sAvg===null?"—":sAvg.toFixed(1)), suf:(sAvg===null?"":"of 25"), sub:(sAvg===null?"No logs scored yet":bandOf(sAvg===null?0:Math.round(sAvg)).label+" · target 16+"), bar:(sAvg?pct(sAvg,25):0), icon:"★", ink:"k-teal" }
  ];

  $("#kpis").innerHTML = kpis.map(k => `
    <div class="kpi ${k.cls||""}">
      <div class="k-icon ${k.ink}">${k.icon}</div>
      <div class="k-label">${k.label}</div>
      <div class="k-val">${k.val} <span>${k.suf}</span></div>
      <div class="k-sub">${k.sub}</div>
      <div class="bar"><i style="width:${k.bar}%"></i></div>
    </div>`).join("");
  $("#tabCountCompletion").textContent = open;
  $("#tabCountScoring").textContent = sCount;
}

/* ---------- matrix ---------- */
function matrixHtml(compact){
  const weeks = DATA.weeks;
  const ps = people();
  const head = `<thead><tr><th>Participant</th>${weeks.map(w=>`<th title="${esc(w.module)}"><span class="wk">W${w.n}</span><span class="dt">${w.date}</span></th>`).join("")}</tr></thead>`;
  const body = ps.map(p => {
    const cells = weeks.map(w => {
      const rec = cellRec(p.id,w.n);
      const st = STATUS[rec.s] || STATUS.planned;
      const isFuture = w.state==="built";
      const label = compact && isFuture ? "·" : st.label;
      const title = `W${w.n} · ${w.module}\n${st.label}${rec.note?"\n"+rec.note:""}`;
      return `<td><button class="cell ${st.cls}" data-pid="${p.id}" data-week="${w.n}" title="${esc(title)}" aria-label="${esc(p.short)} week ${w.n}: ${st.label}">
        <span class="ci">${st.icon}</span>${compact?"":`<span class="cl">${esc(label)}</span>`}
